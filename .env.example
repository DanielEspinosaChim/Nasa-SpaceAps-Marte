# Directorio de datos procesados y crudos (relativo o absoluto)
DATA_DIR=data/processed

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting de endpoints de cálculo (solicitudes por minuto por IP)
RATE_LIMIT_PER_MINUTE=30

# Timeout máximo de cómputo en segundos
COMPUTE_TIMEOUT_SECONDS=10

# API key de NASA (opcional para descargas manuales / InSight)
# NASA_API_KEY=DEMO_KEY
